{
  "components": {
    "schemas": {
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Contractversion",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "maxItems": 20,
            "title": "History",
            "type": "array"
          },
          "question": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "retrievalMode": {
            "enum": [
              "vector",
              "hybrid"
            ],
            "title": "Retrievalmode",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceGeneration"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "contractVersion",
          "requestId",
          "question",
          "history",
          "sources",
          "retrievalMode"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "answerStatus": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "direct_answer"
            ],
            "title": "Answerstatus",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "contractVersion": {
            "const": "1.1.0",
            "title": "Contractversion",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "contractVersion",
          "requestId",
          "answer",
          "answerStatus",
          "citations"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "chunkId": {
            "format": "uuid",
            "title": "Chunkid",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "documentName": {
            "minLength": 1,
            "title": "Documentname",
            "type": "string"
          },
          "generationId": {
            "format": "uuid",
            "title": "Generationid",
            "type": "string"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
          "label": {
            "pattern": "^S[1-9][0-9]*$",
            "title": "Label",
            "type": "string"
          },
          "pageEnd": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pageend"
          },
          "pageStart": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagestart"
          }
        },
        "required": [
          "label",
          "documentId",
          "generationId",
          "chunkId",
          "documentName",
          "pageStart",
          "pageEnd",
          "heading"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "EvaluationChatResponse": {
        "additionalProperties": false,
        "properties": {
          "rerankedCandidates": {
            "items": {
              "$ref": "#/components/schemas/RetrievedCandidate"
            },
            "title": "Rerankedcandidates",
            "type": "array"
          },
          "response": {
            "$ref": "#/components/schemas/ChatResponse"
          },
          "retrievalCandidates": {
            "items": {
              "$ref": "#/components/schemas/RetrievedCandidate"
            },
            "title": "Retrievalcandidates",
            "type": "array"
          }
        },
        "required": [
          "response",
          "retrievalCandidates",
          "rerankedCandidates"
        ],
        "title": "EvaluationChatResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HistoryMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage",
        "type": "object"
      },
      "RetrievedCandidate": {
        "additionalProperties": false,
        "properties": {
          "chunkId": {
            "format": "uuid",
            "title": "Chunkid",
            "type": "string"
          },
          "sourceEnd": {
            "exclusiveMinimum": 0.0,
            "title": "Sourceend",
            "type": "integer"
          },
          "sourceStart": {
            "minimum": 0.0,
            "title": "Sourcestart",
            "type": "integer"
          }
        },
        "required": [
          "chunkId",
          "sourceStart",
          "sourceEnd"
        ],
        "title": "RetrievedCandidate",
        "type": "object"
      },
      "SourceGeneration": {
        "additionalProperties": false,
        "properties": {
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "generationId": {
            "format": "uuid",
            "title": "Generationid",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "generationId"
        ],
        "title": "SourceGeneration",
        "type": "object"
      }
    },
    "securitySchemes": {
      "InternalBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Internal chat, model readiness, and worker-facing service boundary.",
    "title": "Learning RAG internal service",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "A required dependency is unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/chat": {
      "post": {
        "operationId": "chat_internal_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request or contract version"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid internal token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Source snapshot changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Citation is outside retrieved evidence"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Executor response violated the internal contract"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service or model is unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Generation deadline exceeded"
          }
        },
        "security": [
          {
            "InternalBearer": []
          }
        ],
        "summary": "Answer a question over a server-resolved source snapshot",
        "tags": [
          "internal chat"
        ]
      }
    },
    "/internal/evaluation/chat": {
      "post": {
        "operationId": "evaluation_chat_internal_evaluation_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request or retrieval mode"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid internal token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Source snapshot changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Citation is outside retrieved evidence"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Executor response violated the internal contract"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service or model is unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Generation deadline exceeded"
          }
        },
        "security": [
          {
            "InternalBearer": []
          }
        ],
        "summary": "Run internal chat and include retrieved candidates for evaluation",
        "tags": [
          "internal chat"
        ]
      }
    }
  }
}
