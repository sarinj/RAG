DATABASE_URL=postgresql://rag_worker:change-me@postgres:5432/rag
INTERNAL_API_TOKEN=replace-with-a-shared-secret
# ollama, openai, claude, gemini, or huggingface
LLM_PROVIDER=ollama
# Optional generation API URL override; the default depends on the selected provider.
LLM_PROVIDER_BASE_URL=
# Generation API credential; required for hosted APIs.
LLM_PROVIDER_API_KEY=
# Optional independent embedding provider: ollama, openai, gemini, or huggingface.
# Defaults to LLM_PROVIDER except Claude, which defaults to Ollama embeddings.
EMBEDDING_PROVIDER=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
GENERATION_MODEL=
EMBEDDING_MODEL=
# Required for remote embedding providers and must match embeddingDigest in the shared index config.
EMBEDDING_MODEL_DIGEST=
INDEX_CONFIG_PATH=/config/index.json
TOKENIZER_PATH=/config/tokenizer.json
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=52428800
WORKER_POLL_INTERVAL_SECONDS=2
PROVIDER_GENERATION_CONCURRENCY=1
PROVIDER_EMBEDDING_CONCURRENCY=2
GENERATION_TIMEOUT_SECONDS=120

# Retrieval depths retain the existing baseline. Enable one retrieval change at a time.
RAG_QUERY_REWRITE_ENABLED=true
RAG_MULTI_QUERY_ENABLED=false
RAG_MULTI_QUERY_COUNT=3
RAG_DECOMPOSITION_ENABLED=true
RAG_MAX_SUBQUESTIONS=4
RAG_VECTOR_CANDIDATE_LIMIT=30
RAG_LEXICAL_CANDIDATE_LIMIT=30
RAG_RRF_LIMIT=30
RAG_RERANK_LIMIT=30
RAG_RERANK_RESULT_LIMIT=5
RAG_NEIGHBOR_EXPANSION_ENABLED=false
RAG_NEIGHBOR_WINDOW=1
RAG_NEIGHBOR_TOP_N=2
RAG_FINAL_EVIDENCE_LIMIT=5
# Blank uses the available model prompt budget.
RAG_EVIDENCE_TOKEN_BUDGET=
RAG_SUFFICIENCY_CHECK_ENABLED=true
RAG_CLAIM_VALIDATION_ENABLED=true
RAG_ANSWER_REVIEW_ENABLED=false
RAG_ANSWER_REVIEW_MAX_OUTPUT_TOKENS=3072
RAG_ANSWER_REVIEW_REASONING_EFFORT=low
# Optional model for evidence, grounded answers and verification (same provider).
RAG_QUALITY_MODEL=
RAG_CLAIM_VALIDATION_MAX_BATCHES=8
# Grounding checks need a bounded completion budget that also includes reasoning tokens.
RAG_GROUNDING_REASONING_EFFORT=low
RAG_GROUNDING_MAX_OUTPUT_TOKENS=1024
RAG_ANSWER_REASONING_EFFORT=low
RAG_ANSWER_REASONING_TOKEN_BUDGET=512
RAG_TRACE_ENABLED=true
# Full text logging is accepted only when RAG_DEBUG_MODE is also true.
RAG_TRACE_INCLUDE_TEXT=false
RAG_DEBUG_MODE=false
