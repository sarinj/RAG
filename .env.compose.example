# Copy to .env. The default adapter uses models pulled into the Ollama volume.
# Supported LLM_PROVIDER values: ollama, openai, claude, gemini, huggingface.
# Claude uses Ollama embeddings by default; set EMBEDDING_PROVIDER to choose another provider.
# Create backend/config/index-config.json and backend/config/tokenizer.json before startup.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-only
MAX_UPLOAD_BYTES=52428800
INTERNAL_API_TOKEN=replace-with-a-long-random-local-token
LLM_PROVIDER=ollama
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=
GENERATION_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_MODEL_DIGEST=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
