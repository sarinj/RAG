# Copy to .env. The default adapter uses models pulled into the Ollama volume.
# Supported LLM_PROVIDER values: ollama, openai, claude, gemini, huggingface.
# To use OpenAI for generation, set LLM_PROVIDER=openai, add its API key, and
# change GENERATION_MODEL. Keep EMBEDDING_PROVIDER=ollama to reuse the current index.
# For OpenAI embeddings, also set EMBEDDING_PROVIDER=openai, select an embedding
# model/digest in backend/config/index-config.json, then reindex existing documents.
# Claude uses Ollama embeddings by default; set EMBEDDING_PROVIDER to choose another provider.
# Create backend/config/index-config.json and backend/config/tokenizer.json before startup.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-local-only
MAX_UPLOAD_BYTES=52428800
INTERNAL_API_TOKEN=replace-with-a-long-random-local-token
LLM_PROVIDER=ollama
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=
GENERATION_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_MODEL_DIGEST=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Runtime RAG controls; no reindex is needed for these settings.
RAG_QUERY_REWRITE_ENABLED=true
RAG_MULTI_QUERY_ENABLED=false
RAG_MULTI_QUERY_COUNT=3
RAG_DECOMPOSITION_ENABLED=true
RAG_MAX_SUBQUESTIONS=4
RAG_VECTOR_CANDIDATE_LIMIT=30
RAG_LEXICAL_CANDIDATE_LIMIT=30
RAG_RRF_LIMIT=30
RAG_RERANK_LIMIT=30
RAG_RERANK_RESULT_LIMIT=5
RAG_NEIGHBOR_EXPANSION_ENABLED=false
RAG_NEIGHBOR_WINDOW=1
RAG_NEIGHBOR_TOP_N=2
RAG_FINAL_EVIDENCE_LIMIT=5
RAG_EVIDENCE_TOKEN_BUDGET=
RAG_SUFFICIENCY_CHECK_ENABLED=true
RAG_CLAIM_VALIDATION_ENABLED=true
RAG_CLAIM_VALIDATION_MAX_BATCHES=8
RAG_TRACE_ENABLED=true
RAG_TRACE_INCLUDE_TEXT=false
RAG_DEBUG_MODE=false
